{
  "appId": "com.wbhub.wbdesktop",
  "productName": "WorkBuddy Account Hub",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/main.cjs",
    "dist/backend.cjs",
    "build/icon.ico"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "signExecutable": false
  },
  "portable": {
    "artifactName": "wb-desktop-portable.exe"
  },
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "npmRebuild": false
}